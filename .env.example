# Configuration contains environment variable names, never secret values.
GITLAB_API_TOKEN=replace-with-read-api-token
GITLAB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Operator-installed external adapter. Its child environment names are illustrative.
HOST_A_COMMAND_JSON='["/absolute/path/to/runner-host-adapter"]'
HOST_A_ENDPOINT=https://provider.example.invalid
HOST_A_TOKEN=replace-with-hosting-account-token
HOST_A_ACCOUNT_ID=account-example
HOST_A_LIFECYCLE=retained
# Compose only: absolute host path to a compatible Linux executable.
RUNNER_ADAPTER_PATH=/absolute/path/to/runner-host-adapter
# Set each matching numeric runner_id from the GitLab UI in controller.json.
GITLAB_RUNNER_LINUX_TOKEN=glrt-replace-with-linux-runner-token
GITLAB_RUNNER_PROTECTED_TOKEN=glrt-replace-with-protected-runner-token
# Optional: omit to disable /status and /metrics.
ADMIN_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
# Optional on hosts that cannot mount configuration. JSON overrides the file.
CONTROLLER_CONFIG_JSON=
